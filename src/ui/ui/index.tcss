
Placeholder {
  height: 100%;
}

Button {
  height: 100%;
  width: 100%;
}

#mdrc {
  width: 70%;
  align: center middle;
}

#center {
  height: 80%;
}

#logo {
  width: auto;
}

#loading {
  height: 20%;
}

#controller {
  display: none;
  width: 45%;
  grid-size: 3 3;
  grid-rows: 1fr;
  grid-columns: 1fr;
  grid-gutter: 1;
}

#motion-settings {
  display: none;
  width: 25%;
  min-width: 24;
  padding: 1;
  border-left: heavy white;
}

#motion-settings-title {
  height: 2;
  text-style: bold;
}

.motion-label {
  height: 1;
  margin-top: 1;
}

#motion-settings Input {
  height: 3;
}

#apply-motion-settings {
  height: 3;
  margin-top: 1;
}

#motion-settings-status {
  height: 2;
  color: green;
}

#motion-settings-status.error {
  color: red;
}

#log {
  row-span: 3;
  border-left: heavy white;
}

Static {
  height: 100%;
}

#lt {
  border-bottom: round white;
  border-right: round white;
}

#rt {
  border-bottom: round white;
  border-left: round white;
}

#lb {
  border-top: round white;
  border-right: round white;
}

#rb {
  border-top: round white;
  border-left: round white;
}

.invisible {
  display: none;
  width: 0;
  height: 0;
}
