{
  "version": 1,
  "content": {
    "type": "split",
    "direction": "column",
    "items": [
      {
        "proportion": 1,
        "content": {
          "type": "panel",
          "panelType": "ServiceCall",
          "config": {
            "serviceName": "/rpi/supervisor/emergency",
            "requestPayload": "{}",
            "buttonText": "E-STOP \u2014 DISARM",
            "buttonTooltip": "Latch emergency, disarm all motors, stop policy",
            "buttonColor": "#d32f2f",
            "editingMode": false,
            "timeoutSeconds": 3.0
          },
          "title": "E-STOP \u2014 DISARM",
          "version": 1
        }
      },
      {
        "proportion": 1,
        "content": {
          "type": "panel",
          "panelType": "ServiceCall",
          "config": {
            "serviceName": "/rpi/supervisor/script",
            "requestPayload": "{\"name\": \"home_robot\"}",
            "buttonText": "Home robot",
            "buttonTooltip": "Local homing can move motors; ends armed in local holding mode",
            "buttonColor": "#546e7a",
            "editingMode": false,
            "timeoutSeconds": 3.0
          },
          "title": "Home robot",
          "version": 1
        }
      },
      {
        "proportion": 1,
        "content": {
          "type": "panel",
          "panelType": "ServiceCall",
          "config": {
            "serviceName": "/rpi/supervisor/script",
            "requestPayload": "{\"name\": \"restart_policy\"}",
            "buttonText": "Start / restart policy + arm (paused)",
            "buttonTooltip": "Disarm, start/restart managed Orin policy, verify readiness, hold and arm; forwarding stays paused",
            "buttonColor": "#1565c0",
            "editingMode": false,
            "timeoutSeconds": 3.0
          },
          "title": "Start / restart policy + arm (paused)",
          "version": 1
        }
      },
      {
        "proportion": 1,
        "content": {
          "type": "panel",
          "panelType": "ServiceCall",
          "config": {
            "serviceName": "/rpi/supervisor/run",
            "requestPayload": "{}",
            "buttonText": "RUN \u2014 ENABLE POLICY MOTION",
            "buttonTooltip": "Enable trained-policy motion only after READY",
            "buttonColor": "#ed6c02",
            "editingMode": false,
            "timeoutSeconds": 3.0
          },
          "title": "RUN \u2014 ENABLE POLICY MOTION",
          "version": 1
        }
      },
      {
        "proportion": 1,
        "content": {
          "type": "panel",
          "panelType": "ServiceCall",
          "config": {
            "serviceName": "/rpi/supervisor/idle",
            "requestPayload": "{}",
            "buttonText": "Pause policy motion \u2014 hold",
            "buttonTooltip": "Pause forwarding, keep motors armed at their last targets",
            "buttonColor": "#546e7a",
            "editingMode": false,
            "timeoutSeconds": 3.0
          },
          "title": "Pause policy motion \u2014 hold",
          "version": 1
        }
      },
      {
        "proportion": 3,
        "content": {
          "type": "panel",
          "panelType": "RawMessages",
          "config": {
            "expansion": "all",
            "topicPath": "/rpi/supervisor/status"
          },
          "title": "Pi supervisor status and operator prompt",
          "version": 1
        }
      },
      {
        "proportion": 1,
        "content": {
          "type": "panel",
          "panelType": "ServiceCall",
          "config": {
            "serviceName": "/rpi/supervisor/respond",
            "requestPayload": "{\"name\":\"COPY_CURRENT_PROMPT_ID\"}",
            "buttonText": "Confirm clearance",
            "editingMode": true,
            "timeoutSeconds": 3.0
          },
          "title": "Confirm current operator prompt",
          "version": 1
        }
      }
    ]
  }
}
