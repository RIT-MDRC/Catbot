{
	"name": "utilities",
	"version": "0.0.2",
	"description": "installer and cli for catbot",
	"main": "cli/index.js",
	"scripts": {
		"test": "node --test cli/*.test.js",
		"meow": "echo \"Meow\""
	},
	"bin": {
		"catbot": "./cli/index.js",
		"cb": "./cli/index.js"
	},
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RIT-MDRC/Catbot.git"
	},
	"keywords": [
		"catbot",
		"mdrc",
		"catbot-cli"
	],
	"author": "Hiroto",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/RIT-MDRC/Catbot/issues"
	},
	"homepage": "https://github.com/RIT-MDRC/Catbot#readme",
	"files": [
		"cli/index.js",
		"cli/README.md",
		"src/**/*.py",
		"src/**/*.json",
		"src/**/*.dbc",
		"src/**/*.tcss",
		"src/**/*.txt",
		"src/**/*.md",
		"src/**/package.xml",
		"src/**/setup.cfg",
		"src/**/resource/*",
		"!src/**/test/**",
		"!src/foundation/foundation/.python-version",
		"!src/foundation/foundation/pyproject.toml",
		"!src/foundation/foundation/uv.lock",
		"pyproject.toml",
		"uv.lock",
		".python-version",
		"README.md",
		"LICENSE"
	],
	"dependencies": {
		"yargs": "^17.7.3"
	}
}
